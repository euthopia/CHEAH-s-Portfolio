// CHEAH-GPT · tokens dealt by tasteskill (software / AI): palette cool-grey-cobalt, type host
.cg
    --cg-bg #eef0f3
    --cg-surface #e2e5ea
    --cg-card #f7f8fa
    --cg-ink #0b0c0e
    --cg-muted #5b616b
    --cg-line rgba(11, 12, 14, 0.1)
    --cg-accent #1f2de6
    --cg-accent-ink #ffffff
    --cg-ease cubic-bezier(.2, .8, .2, 1)
    --cg-ease-enter cubic-bezier(.22, 1, .36, 1)
    --cg-r-lg 22px
    --cg-r-md 14px
    --cg-r-sm 10px
    --cg-sans 'Host Grotesk', 'Nunito', system-ui, sans-serif
    --cg-mono 'JetBrains Mono', ui-monospace, monospace
    position fixed
    inset 0
    pointer-events none
    z-index 20
    font-family var(--cg-sans)
    color var(--cg-ink)
    -webkit-font-smoothing antialiased

    *
        box-sizing border-box

    svg
        display block
        width 100%
        height 100%

    button, a, input
        font inherit
        color inherit

    :focus-visible
        outline 2px solid var(--cg-accent)
        outline-offset 2px

    .cg-sr
        position absolute
        width 1px
        height 1px
        overflow hidden
        clip rect(0 0 0 0)

    // Orb: the assistant's mark, a slow conic sweep (linear loop)
    .cg-orb
        flex none
        position relative
        width 22px
        height 22px
        border-radius 50%
        background conic-gradient(from 0deg, #1f2de6, #6fa8ff, #e8f0ff, #1f2de6)
        animation cg-spin 4s linear infinite
        box-shadow inset 0 0 0 1px rgba(255, 255, 255, 0.35)

        &::after
            content ''
            position absolute
            inset 5px
            border-radius 50%
            background #0b0c0e
            box-shadow 0 0 0 1px rgba(255, 255, 255, 0.15)

        &--lg
            width 40px
            height 40px

            &::after
                inset 9px

        &--sm
            width 24px
            height 24px
            margin-top 2px

    // Launcher
    .cg-launcher
        pointer-events auto
        position absolute
        top 16px
        left 50%
        display flex
        align-items center
        gap 10px
        min-height 44px
        padding 0 8px 0 10px
        border 1px solid rgba(255, 255, 255, 0.6)
        border-radius 999px
        background rgba(238, 240, 243, 0.86)
        backdrop-filter blur(14px) saturate(1.4)
        box-shadow 0 8px 24px rgba(11, 12, 14, 0.18)
        font-size 14px
        font-weight 500
        letter-spacing -0.01em
        cursor pointer
        transform translateX(-50%)
        transition transform 120ms var(--cg-ease), background 120ms var(--cg-ease), box-shadow 120ms var(--cg-ease)
        animation cg-enter 1.1s var(--cg-ease-enter) backwards

        @media (hover: hover) and (pointer: fine)
            &:hover
                transform translate(-50%, -1px)
                background rgba(247, 248, 250, 0.96)
                box-shadow 0 12px 28px rgba(11, 12, 14, 0.22)
                transition-duration 150ms

        &:active
            transform translate(-50%, 1px) scale(.985)
            transition-duration 90ms

        kbd
            display grid
            place-items center
            min-width 26px
            height 26px
            padding 0 6px
            border-radius 8px
            background var(--cg-ink)
            color #fff
            font 500 12px var(--cg-mono)

        @media (max-width 600px)
            top auto
            bottom 16px
            left auto
            right 16px
            padding 0 10px
            transform none

            &:active
                transform scale(.985)

            .cg-launcher-label, kbd
                display none

    &.is-open .cg-launcher
        opacity 0
        pointer-events none

    // Panel: a floating sheet docked right (desktop), bottom sheet (phone)
    .cg-panel
        pointer-events auto
        position absolute
        top 16px
        right 16px
        bottom 16px
        width 400px
        max-width calc(100vw - 32px)
        display flex
        flex-direction column
        border 1px solid rgba(255, 255, 255, 0.7)
        border-radius var(--cg-r-lg)
        background rgba(238, 240, 243, 0.94)
        backdrop-filter blur(20px) saturate(1.4)
        box-shadow 0 24px 64px rgba(11, 12, 14, 0.28)
        overflow hidden
        opacity 0
        transform translateX(16px)
        transition opacity 200ms var(--cg-ease), transform 200ms var(--cg-ease)

        @media (max-width 600px)
            top auto
            left 8px
            right 8px
            bottom 8px
            width auto
            max-width none
            height min(86vh, 680px)
            transform translateY(24px)

    &.is-open .cg-panel
        opacity 1
        transform none

    .cg-head
        display flex
        align-items center
        gap 12px
        padding 14px 12px 14px 16px
        border-bottom 1px solid var(--cg-line)

        h2
            margin 0
            font-size 17px
            font-weight 500
            letter-spacing -0.02em

        p
            display flex
            align-items center
            gap 6px
            margin 2px 0 0
            color var(--cg-muted)
            font 400 12px var(--cg-mono)

    .cg-head-text
        flex 1
        min-width 0

    .cg-live
        width 7px
        height 7px
        border-radius 50%
        background #19a35b
        box-shadow 0 0 0 3px rgba(25, 163, 91, 0.18)

    .cg-icon-btn
        display grid
        place-items center
        width 44px
        height 44px
        padding 12px
        border none
        border-radius 12px
        background transparent
        cursor pointer
        transition background 120ms var(--cg-ease), transform 120ms var(--cg-ease)

        &:hover
            background var(--cg-surface)

        &:active
            transform scale(.985)

    .cg-scroll
        flex 1
        overflow-y auto
        padding 16px
        overscroll-behavior contain
        scrollbar-width thin

    // Profile card
    .cg-intro
        padding 18px
        border-radius var(--cg-r-md)
        background var(--cg-ink)
        color #fff
        background-image radial-gradient(120% 140% at 100% 0%, rgba(31, 45, 230, 0.55), transparent 55%)

    .cg-eyebrow
        margin 0 0 10px
        color rgba(255, 255, 255, 0.6)
        font 500 11px var(--cg-mono)
        letter-spacing 0.08em
        text-transform uppercase

    .cg-name
        margin 0
        font-size 26px
        font-weight 500
        line-height 1.05
        letter-spacing -0.04em

    .cg-role
        margin 6px 0 16px
        color rgba(255, 255, 255, 0.72)
        font-size 14px

    .cg-quick
        display flex
        gap 8px

    .cg-quick-btn
        width 44px
        height 44px
        padding 8px
        border-radius 12px
        background rgba(255, 255, 255, 0.08)
        border 1px solid rgba(255, 255, 255, 0.12)
        transition transform 150ms var(--cg-ease), background 150ms var(--cg-ease)

        svg
            border-radius 6px

        @media (hover: hover) and (pointer: fine)
            &:hover
                transform translateY(-2px)
                background rgba(255, 255, 255, 0.16)

        &:active
            transform translateY(1px) scale(.985)
            transition-duration 90ms

    // Messages
    .cg-log
        display flex
        flex-direction column
        gap 14px
        padding-top 16px

    .cg-msg
        display flex
        gap 10px
        animation cg-msg 200ms var(--cg-ease) both

        p
            margin 0
            font-size 15px
            line-height 1.5

        &--user
            justify-content flex-end

            p
                max-width 82%
                padding 10px 14px
                border-radius 16px 16px 4px 16px
                background var(--cg-accent)
                color var(--cg-accent-ink)

        &--bot
            .cg-body
                flex 1
                min-width 0

    .cg-dots
        display inline-flex
        gap 4px
        padding 8px 0

        i
            width 6px
            height 6px
            border-radius 50%
            background var(--cg-muted)
            animation cg-dot 1.2s var(--cg-ease) infinite

            &:nth-child(2)
                animation-delay 0.15s

            &:nth-child(3)
                animation-delay 0.3s

    .cg-block
        margin-top 10px
        animation cg-msg 240ms var(--cg-ease) both

    // Contact rows (linked cards: lift 2px)
    .cg-contact
        display grid
        gap 6px

    .cg-contact-row
        display flex
        align-items center
        gap 12px
        min-height 56px
        padding 10px 14px 10px 10px
        border 1px solid var(--cg-line)
        border-radius var(--cg-r-sm)
        background var(--cg-card)
        text-decoration none
        transition transform 180ms var(--cg-ease), border-color 180ms var(--cg-ease), box-shadow 180ms var(--cg-ease)

        svg
            flex none
            width 32px
            height 32px

        span
            flex 1
            min-width 0
            display flex
            flex-direction column

        b
            font-weight 500
            font-size 14px

        small
            color var(--cg-muted)
            font 400 12px var(--cg-mono)
            overflow hidden
            text-overflow ellipsis
            white-space nowrap

        i
            font-style normal
            color var(--cg-muted)
            transition transform 150ms var(--cg-ease)

        @media (hover: hover) and (pointer: fine)
            &:hover
                transform translateY(-2px)
                border-color rgba(11, 12, 14, 0.22)
                box-shadow 0 8px 24px rgba(11, 12, 14, 0.08)

                i
                    transform translate(3px, -3px)
                    color var(--cg-accent)

        &:active
            transform translateY(0) scale(.985)

    // Grades
    .cg-stats
        display grid
        grid-template-columns repeat(3, 1fr)
        gap 6px

    .cg-stat
        display flex
        flex-direction column
        padding 12px
        border 1px solid var(--cg-line)
        border-radius var(--cg-r-sm)
        background var(--cg-card)

        b
            font-size 34px
            font-weight 500
            line-height 1
            letter-spacing -0.04em
            font-variant-numeric tabular-nums

        span
            color var(--cg-muted)
            font-size 13px

        small
            margin-top 10px
            font 500 11px var(--cg-mono)
            letter-spacing 0.06em

    .cg-total
        display flex
        align-items baseline
        gap 8px
        margin-top 6px
        padding 12px 14px
        border-radius var(--cg-r-sm)
        background var(--cg-accent)
        color #fff

        span
            font-size 13px
            opacity 0.8

        b
            font-size 28px
            font-weight 500
            letter-spacing -0.03em
            font-variant-numeric tabular-nums

    // Timeline
    .cg-timeline
        list-style none
        margin 0
        padding 0 0 0 4px

        li
            position relative
            display flex
            flex-direction column
            padding 0 0 14px 20px
            border-left 1px solid var(--cg-line)

            &:last-child
                padding-bottom 0

            &::before
                content ''
                position absolute
                left -5px
                top 4px
                width 9px
                height 9px
                border-radius 50%
                background var(--cg-bg)
                border 2px solid var(--cg-muted)

            &.is-now::before
                border-color var(--cg-accent)
                background var(--cg-accent)
                box-shadow 0 0 0 4px rgba(31, 45, 230, 0.15)

        small
            color var(--cg-muted)
            font 500 11px var(--cg-mono)
            letter-spacing 0.06em
            text-transform uppercase

        b
            font-weight 500
            font-size 15px

        span
            color var(--cg-muted)
            font-size 13px

    .cg-tags
        display flex
        flex-wrap wrap
        gap 6px

        span
            padding 6px 10px
            border 1px solid var(--cg-line)
            border-radius 999px
            background var(--cg-card)
            font 500 12px var(--cg-mono)

    // Prompt cards (horizontal rail)
    .cg-prompts
        display flex
        gap 8px
        padding 10px 16px
        overflow-x auto
        scrollbar-width none
        border-top 1px solid var(--cg-line)

        &::-webkit-scrollbar
            display none

    .cg-prompt
        flex none
        display flex
        flex-direction column
        align-items flex-start
        gap 4px
        min-height 56px
        max-width 190px
        padding 10px 12px
        border 1px solid var(--cg-line)
        border-radius var(--cg-r-sm)
        background var(--cg-card)
        text-align left
        cursor pointer
        transition transform 180ms var(--cg-ease), border-color 180ms var(--cg-ease)

        small
            color var(--cg-accent)
            font 500 11px var(--cg-mono)

        span
            font-size 13px
            line-height 1.3

        @media (hover: hover) and (pointer: fine)
            &:hover
                transform translateY(-2px)
                border-color rgba(11, 12, 14, 0.22)

        &:active
            transform scale(.985)

    // Composer
    .cg-form
        display flex
        gap 8px
        margin 0 16px
        padding 6px
        border 1px solid var(--cg-line)
        border-radius 16px
        background var(--cg-card)
        transition border-color 150ms var(--cg-ease), box-shadow 150ms var(--cg-ease)

        &:focus-within
            border-color var(--cg-accent)
            box-shadow 0 0 0 4px rgba(31, 45, 230, 0.12)

    .cg-input
        flex 1
        min-width 0
        min-height 44px
        padding 0 10px
        border none
        background transparent
        font-size 15px
        outline none

        &::placeholder
            color var(--cg-muted)

    .cg-input:focus-visible
        outline none

    .cg-send
        flex none
        display grid
        place-items center
        width 44px
        height 44px
        padding 12px
        border none
        border-radius 12px
        background var(--cg-accent)
        color #fff
        cursor pointer
        transition transform 150ms var(--cg-ease), background 150ms var(--cg-ease)

        @media (hover: hover) and (pointer: fine)
            &:hover
                transform translateY(-1px)
                background #1925c4

        &:active
            transform translateY(1px) scale(.985)
            transition-duration 90ms

    .cg-foot
        display flex
        justify-content space-between
        margin 0
        padding 10px 18px 14px
        color var(--cg-muted)
        font 400 11px var(--cg-mono)

    @media (prefers-reduced-motion: reduce)
        *, *::before, *::after
            animation-duration 0.01ms !important
            animation-iteration-count 1 !important
            transition-duration 0.01ms !important

@keyframes cg-spin
    to
        transform rotate(360deg)

@keyframes cg-enter
    from
        opacity 0
        translate 0 -8px
    to
        opacity 1
        translate 0 0

@keyframes cg-msg
    from
        opacity 0
        translate 0 6px
    to
        opacity 1
        translate 0 0

@keyframes cg-dot
    0%, 100%
        opacity 0.25
        transform translateY(0)
    50%
        opacity 1
        transform translateY(-3px)

.discord.about
    .about-total
        text-align center
        font 900 3.2rem 'Nunito', sans-serif
        color #ffceca
        margin -1rem 0 1.5rem
        text-shadow 0 0 20px rgba(255, 111, 177, 0.6)

    .about-grade
        font 900 2rem 'Nunito', sans-serif
        margin 0.2rem 0 0.4rem
        color #fff

.discord.about .about-contact
    margin-top 1rem
    line-height 1.8

    a
        color #ffceca
